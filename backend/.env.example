# Backend configuration. Copy to `.env` for local dev — the justfile loads it
# into the shell (`just dev`). Pydantic reads only the process environment, so
# this file is never parsed by the app directly.
#
# Mandatory settings have no default: a missing variable fails at boot. The
# optional block at the bottom carries safe defaults.

# ── Mandatory ───────────────────────────────────────────────────────────────

# Deployment target: local | development | production | testing.
# Only `production` enforces the full guardrail set (Auth0 required, dev
# backdoor refused, Postgres only, non-localhost FRONTEND_ORIGIN, deliverability
# check on). A bad prod config fails loudly at boot instead of running wrong.
ENVIRONMENT=local

# Public frontend origin for the CORS allow-list. Production rejects
# localhost / 127.0.0.1.
FRONTEND_ORIGIN=http://localhost:3000

# SQLAlchemy URL — the single source of truth for where data lives.
#   host dev   : sqlite:///./data/flowfic.db
#   docker dev : sqlite:////data/flowfic.db   (note the 4 slashes = absolute)
#   production : postgresql+psycopg://user:pass@host:5432/dbname
#                (a plain postgresql:// URL is auto-upgraded to psycopg)
DATABASE_URL=sqlite:///./data/flowfic.db

# Auth0 tenant. AUTH0_DOMAIN is the host with no scheme; AUTH0_AUDIENCE is the
# API identifier our backend requires as the access-token `aud` claim (must
# match the frontend's NEXT_PUBLIC_AUTH0_AUDIENCE). The backend validates RS256
# tokens against the tenant JWKS — there is no client secret on the server.
# Required and non-empty in production; may be left empty otherwise, where the
# dev backdoor below stands in. Declare them explicitly even when empty.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# ── Optional (defaults shown) ────────────────────────────────────────────────

# Local-dev backdoor. `POST /auth/dev-login` mints a `<DEV_USER_TOKEN>:<user>`
# token resolvable against a pre-seeded User row (it cannot create accounts).
# Refused entirely in production. When enabled, DEV_USER_TOKEN must be non-empty.
DEV_USER_ENABLED=true
DEV_USER_TOKEN=dev-token-please-rotate

# When true, email-validator runs a DNS MX lookup on profile email updates.
# Defaults off for offline dev; production forces it on.
EMAIL_VALIDATION_CHECK_DELIVERABILITY=false
