# --------------------------------------------------------------------------
# Global options
# --------------------------------------------------------------------------
{
	# Public site only — there's no automatic Let's Encrypt to ship.
	# We disable the on-demand TLS path entirely (defensive: prevents Caddy
	# from ever trying to issue a cert for an unknown SNI it receives from
	# a probe).
	auto_https disable_redirects

	# Trust Cloudflare as the reverse proxy so the real client IP comes
	# from `CF-Connecting-IP` (preferred over X-Forwarded-For for CF).
	# IP ranges from https://www.cloudflare.com/ips/. Refresh periodically.
	# When we later add a firewall, the same list should drive nft/ufw rules.
	servers {
		client_ip_headers CF-Connecting-IP X-Forwarded-For
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}

	# Caddy process / system errors (startup, TLS provisioning, panics).
	# HTTP access logs are separate — see site block below.
	log {
		level ERROR
		format json
		output file /var/log/caddy/error.log {
			roll_size 10mb
			roll_keep 10
		}
	}
}

# --------------------------------------------------------------------------
# Port 80: redirect the real domain, drop everything else.
# Cloudflare flips http→https for browsers, but this still fires when:
#   - someone hits the origin IP directly,
#   - CF probes the origin during health checks,
#   - we (temporarily) bypass CF.
# --------------------------------------------------------------------------
:80 {
	@domain host flowfic.app
	redir @domain https://flowfic.app{uri} permanent
	# No matching host → close the connection. Bots scanning by IP get nothing.
	abort
}

# --------------------------------------------------------------------------
# Bare-IP HTTPS catch-all.
# Anything that reaches :443 without SNI=flowfic.app gets killed at the
# TLS layer. We use an internal self-signed cert so Caddy has *something*
# to present during the handshake; the actual content path is `abort`.
# This dramatically cuts noise from bots scanning IPv4 space.
# --------------------------------------------------------------------------
:443 {
	tls internal
	abort
}

# --------------------------------------------------------------------------
# Main site — flowfic.app
# --------------------------------------------------------------------------
flowfic.app {
	# Cloudflare Origin Certificate. The .pem + .key live under
	# `/etc/caddy/certs/` inside the container. See docker-compose.yaml for
	# how the host-side `conf/certs/` directory is bind-mounted.
	tls /etc/caddy/certs/flowfic.app.pem /etc/caddy/certs/flowfic.app.key

	# Access log — JSON, all routes.
	log {
		format json
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 10
		}
	}

	# ---- Security headers ------------------------------------------------
	# Rate limiting is deliberately NOT done here: it lives in Cloudflare
	# rules (dashboard-managed), which sit in front of this origin.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# CSP notes:
		#   - script/style 'unsafe-inline': the Next.js static export boots via
		#     inline scripts, and React writes inline style attributes.
		#   - connect-src includes the Auth0 tenant for the SPA token exchange
		#     (PKCE + refresh-token rotation) — keep in sync with
		#     NEXT_PUBLIC_AUTH0_DOMAIN / the api service's AUTH0_DOMAIN.
		#   - img-src allows any https host (social-login avatars) and data:
		#     URLs (user-uploaded profile pictures).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://dev-kkowu0p3at2rwdwt.us.auth0.com; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
		-Server
	}

	# On-the-fly compression. Cloudflare also compresses, but if we ever
	# bypass CF (origin checks, internal tooling) we still want this on.
	encode zstd gzip

	# ---- API: FastAPI in Docker ------------------------------------------
	# The upstream sets `root_path="/api"` so Starlette strips this prefix
	# during routing — do NOT use `handle_path` here, the app needs the
	# prefix in the scope.
	handle /api/* {
		# API responses are user-specific; don't let the CDN or back/forward
		# cache hold onto them.
		header Cache-Control "no-store"
		reverse_proxy api:8000
	}

	# ---- Static frontend: Next.js export from out/ -----------------------
	handle {
		root * /static

		# Long-cache the immutable Next.js asset bundle. Files under
		# `_next/static/*` carry content-hashed names, so we mark them
		# immutable for a year. Everything else (HTML, /icon.svg, etc.) is
		# served with a short-lived public cache so deploys propagate fast.
		@immutable path /_next/static/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# Generated data assets under public/ (word match maps, the quote pool,
		# the film-grab inspiration catalog). Their filenames carry a *schema*
		# version (….vN.…), but the contents are regenerated / re-sliced within a
		# version, so we don't freeze them like the hashed bundle above. A short
		# public cache plus revalidation (file_server sends ETag + Last-Modified)
		# lets a redeploy propagate quickly while unchanged fetches stay cheap
		# 304s. The app also fetches each file at most once per page load.
		@data path /match-map/* /quotes/* /inspiration/*
		header @data Cache-Control "public, max-age=3600, must-revalidate"

		@html path *.html /
		header @html Cache-Control "public, max-age=60, must-revalidate"

		try_files {path} {path}.html {path}/index.html
		file_server
	}

	# 404 fallback (Next.js exports a 404.html at the root)
	handle_errors {
		@404 expression {http.error.status_code} == 404
		handle @404 {
			root * /static
			rewrite * /404.html
			file_server
		}
	}
}
